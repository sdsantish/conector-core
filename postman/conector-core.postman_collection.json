    {
      "name": "PRUEBAPCML (RPG)",
      "description": "Programa RPG con estructuras y arreglos dim(5). PCML generado por el compilador: pruebapcml.pcml",
      "item": [
        {
          "name": "Procesar carrito",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "const out = pm.response.json().resultado.POUTPUT;",
                  "pm.test(\"STATUS SUCCESS\", () => pm.expect(out.STATUS).to.eql(\"SUCCESS\"));",
                  "pm.test(\"Total 3 + 4 = 7\", () => pm.expect(out.TOTALCARRITO).to.eql(7));",
                  "pm.test(\"La lista vuelve con 5 posiciones\", () => pm.expect(pm.response.json().resultado.PINPUT.LISTAPROD).to.have.lengthOf(5));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/programa",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "programa"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"pcml\": \"pruebapcml\",\n  \"parametros\": {\n    \"pInput\": {\n      \"idCliente\": 1,\n      \"nombre\": \"CARLOS\",\n      \"totalItems\": 2,\n      \"listaProd\": [\n        {\n          \"idProducto\": 10,\n          \"cantidad\": 3\n        },\n        {\n          \"idProducto\": 20,\n          \"cantidad\": 4\n        }\n      ]\n    }\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "totalItems fuera de rango (lo rechaza el programa)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "const out = pm.response.json().resultado.POUTPUT;",
                  "pm.test(\"STATUS ERROR\", () => pm.expect(out.STATUS).to.eql(\"ERROR\"));",
                  "pm.test(\"Mensaje del programa\", () => pm.expect(out.MSG).to.eql(\"totalItems debe estar entre 0 y 5\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/programa",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "programa"
              ]
            },
            "description": "El conector acepta la petición; es el programa RPG el que valida totalItems y responde ERROR.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"pcml\": \"pruebapcml\",\n  \"parametros\": {\n    \"pInput\": {\n      \"idCliente\": 1,\n      \"nombre\": \"CARLOS\",\n      \"totalItems\": 6,\n      \"listaProd\": [\n        {\n          \"idProducto\": 10,\n          \"cantidad\": 3\n        },\n        {\n          \"idProducto\": 20,\n          \"cantidad\": 4\n        }\n      ]\n    }\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    },
    {
      "name": "CLIENTES (SQLRPGLE)",
      "description": "Alta y consulta sobre la tabla SDSANTISH1.CLIENTES. Ejecutar en orden. PCML: cliins.pcml, clicon.pcml",
      "item": [
        {
          "name": "Insertar cliente",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "const r = pm.response.json().resultado;",
                  "pm.test(\"STATUS SUCCESS\", () => pm.expect(r.status).to.eql(\"SUCCESS\"));",
                  "pm.test(\"Devuelve el ID generado\", () => pm.expect(r.id).to.be.above(0));",
                  "pm.collectionVariables.set(\"clienteId\", r.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/programa",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "programa"
              ]
            },
            "description": "Inserta con CLIINS y guarda el ID en la variable de colección clienteId.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"pcml\": \"cliins\",\n  \"parametros\": {\n    \"nombre\": \"CARLOS\",\n    \"ciudad\": \"Lima\"\n  }\n}",
