{
  "info": {
    "name": "conector-core",
    "description": "Casos de prueba de POST /programa. Ver README.md. Las carpetas de programas necesitan los programas creados en el AS400 (guide-local.md); 'Errores de validación' funciona sin AS400.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "SALUDO (CL)",
      "description": "Programa CL con texto de entrada y salida. PCML: saludo.pcml",
      "item": [
        {
          "name": "Saludar",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Devuelve HOLA CARLOS\", () => pm.expect(pm.response.json().resultado.msg).to.eql(\"HOLA CARLOS\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/programa",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "programa"
              ]
            },
            "description": "Llama a SDSANTISH1/SALUDO y devuelve el mensaje armado por el programa.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"pcml\": \"saludo\",\n  \"parametros\": {\n    \"name\": \"CARLOS\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    },
