          }
        },
        {
          "name": "Consultar por ciudad",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "const r = pm.response.json().resultado;",
                  "pm.test(\"STATUS SUCCESS\", () => pm.expect(r.status).to.eql(\"SUCCESS\"));",
                  "pm.test(\"cantidad coincide con la lista\", () => pm.expect(r.clientes).to.have.lengthOf(r.cantidad));",
                  "pm.test(\"Todos son de LIMA\", () => r.clientes.forEach(c => pm.expect(c.ciudad).to.eql(\"LIMA\")));",
                  "const id = pm.collectionVariables.get(\"clienteId\");",
                  "if (id) pm.test(\"Incluye el cliente insertado\", () => pm.expect(r.clientes.map(c => c.id)).to.include(Number(id)));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/programa",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "programa"
              ]
            },
            "description": "La ciudad se guarda en mayúsculas, así que 'lima' encuentra 'LIMA'.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"pcml\": \"clicon\",\n  \"parametros\": {\n    \"ciudad\": \"lima\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
